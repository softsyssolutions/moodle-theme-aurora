{{!
    @template theme_aurora/frontpage_welcome

    Campus entry (Página Principal). Guest-first giant welcome sticky —
    never clones the /my/ standup board. Context from
    aurora_frontpage_welcome_context().

    Impeccable plate provenance:
    assets/plates/sticky-paper-frontpage.png → pix/whiteboard/sticky-paper-frontpage.png
    assets/plates/tray-frontpage.png → pix/whiteboard/tray-frontpage.png
}}
<section class="aurora-front d-print-none" data-region="aurora-front" aria-label="{{sitename}}">
    <div class="aurora-front__stage">
        <article class="aurora-front__sticky aurora-front__sticky--yellow">
            {{#paperurl}}
            <img class="aurora-front__paper"
                 src="{{{paperurl}}}"
                 data-plate-source="assets/plates/sticky-paper-frontpage.png"
                 alt=""
                 aria-hidden="true"
                 width="1200"
                 height="1200">
            {{/paperurl}}
            <h1 class="aurora-front__title">{{title}}</h1>
            <span class="aurora-front__rule" aria-hidden="true"></span>
            <p class="aurora-front__subtitle">{{subtitle}}</p>
            <div class="aurora-front__actions">
                <a class="aurora-front__cta" href="{{{ctaurl}}}">{{ctalabel}} &rarr;</a>
                {{#hassecondary}}
                <a class="aurora-front__secondary" href="{{{secondaryurl}}}">{{secondarylabel}}</a>
                {{/hassecondary}}
            </div>
        </article>
    </div>
    {{#trayurl}}
    <div class="aurora-front__tray" aria-hidden="true">
        <img class="aurora-front__tray-img"
             src="{{{trayurl}}}"
             data-plate-source="assets/plates/tray-frontpage.png"
             alt=""
             width="2048"
             height="308"
             loading="lazy"
             decoding="async">
    </div>
    {{/trayurl}}
</section>
