{{!
    @template theme_aurora/page_header

    Lightweight branded section header (title + real subtitle). Used to replace
    the plain "My courses" heading. No faked data — the subtitle counts come from
    the renderer.

    Example context (json):
    { "title": "My courses", "subtitle": "Enrolled in 4 courses · 2 completed" }
}}
<div class="aurora-page-header d-print-none" data-region="aurora-page-header">
    <h1 class="aurora-page-header__title">{{title}}</h1>
    <p class="aurora-page-header__subtitle">{{subtitle}}</p>
</div>
