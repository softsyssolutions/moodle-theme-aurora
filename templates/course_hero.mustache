{{!
    @template theme_aurora/course_hero

    Aurora course-view hero. Replaces the plain course heading on the course main
    page. All values are REAL (course name / summary / category, viewable lesson
    count, active enrolment count, the current user's completion ring + continue
    target) from core_renderer::aurora_course_hero_context().
}}
<div class="aurora-course-hero d-print-none" data-region="aurora-course-hero">
    <nav class="aurora-course-hero__crumbs" aria-label="breadcrumb">
        <a href="{{mycoursesurl}}">{{mycourseslabel}}</a>
        <span aria-hidden="true">/</span>
        <span class="aurora-course-hero__crumb-current">{{fullname}}</span>
    </nav>

    <div class="aurora-course-hero__card">
        <div class="aurora-course-hero__banner{{#hasimage}} aurora-course-hero__banner--hasimage{{/hasimage}}">
            {{#hasimage}}
            <img class="aurora-course-hero__img"
                 src="{{{imageurl}}}"
                 alt=""
                 width="1200"
                 height="400">
            {{/hasimage}}
            {{^hasimage}}
            <span class="aurora-course-hero__glyph" aria-hidden="true">{{initial}}</span>
            {{/hasimage}}
        </div>
        <div class="aurora-course-hero__body">
            <div class="aurora-course-hero__info">
                {{#hascategory}}
                    <span class="aurora-course-hero__chip">{{category}}</span>
                {{/hascategory}}
                <h1 class="aurora-course-hero__title">{{fullname}}</h1>
                {{#hassummary}}
                    <p class="aurora-course-hero__summary">{{summary}}</p>
                {{/hassummary}}
                <div class="aurora-course-hero__meta">
                    {{#haslessons}}<span>{{lessonslabel}}</span>{{/haslessons}}
                    {{#hasenrolled}}<span>{{enrolledlabel}}</span>{{/hasenrolled}}
                </div>
            </div>

            {{#hascompletion}}
                <div class="aurora-course-hero__progress">
                    <div class="aurora-course-hero__pct">{{completionpct}}%</div>
                    <div class="aurora-course-hero__bar" aria-hidden="true">
                        <span style="width: {{completionpct}}%;"></span>
                    </div>
                    <div class="aurora-course-hero__completed">{{completedlabel}}</div>
                    <a href="{{continueurl}}" class="aurora-course-hero__btn">{{continuelabel}} &rarr;</a>
                </div>
            {{/hascompletion}}
        </div>
    </div>
</div>
