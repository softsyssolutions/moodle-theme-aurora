{{!
    @template theme_aurora/login

    Whiteboard split-board login. Boost head/footer plus real main_content
    (core/loginform). Chrome only.

    Context:
    * sitename, homeurl, brand, title, subtitle, paperurl, trayurl
    * output, bodyattributes

    Impeccable plate provenance:
    assets/plates/paper-login.png → pix/whiteboard/paper-login.png
    assets/plates/tray-frontpage.png → pix/whiteboard/tray-frontpage.png
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper" class="aurora-login-wrap">
    {{{ output.standard_top_of_body_html }}}

    <header class="aurora-login-bar">
        <a class="aurora-login-bar__brand" href="{{{homeurl}}}">{{brand}}</a>
        <span class="aurora-login-bar__current">{{#str}}login{{/str}}</span>
    </header>

    <div id="page" class="aurora-login-page">
        <div class="aurora-login-stage">
            <div class="aurora-login-welcome">
                <h1 class="aurora-login-welcome__title">
                    <img class="aurora-login-welcome__title-image"
                         src="{{{titleimageurl}}}"
                         data-plate-source=".impeccable/mocks/decision/login-split-board.webp"
                         alt="{{title}}"
                         width="570"
                         height="300">
                </h1>
                <p class="aurora-login-welcome__sub">{{subtitle}}</p>
            </div>
            <div class="aurora-login-paper">
                {{#paperurl}}
                <img class="aurora-login-paper__img"
                     src="{{{paperurl}}}"
                     data-plate-source="assets/plates/paper-login.png"
                     alt=""
                     aria-hidden="true"
                     width="746"
                     height="1026">
                {{/paperurl}}
                <div class="aurora-login-paper__form">
                    {{{ output.main_content }}}
                </div>
            </div>
        </div>
        {{#trayurl}}
        <div class="aurora-login-tray" aria-hidden="true">
            <img class="aurora-login-tray__img"
                 src="{{{trayurl}}}"
                 data-plate-source="assets/plates/tray-frontpage.png"
                 alt=""
                 width="2048"
                 height="308"
                 decoding="async">
        </div>
        {{/trayurl}}
    </div>

    {{> theme_boost/footer }}
</div>
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
